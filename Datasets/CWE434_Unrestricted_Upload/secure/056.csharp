using Microsoft.AspNetCore.Mvc;using System;public class C:Controller{[HttpPost("/upload")]public IActionResult U(){var f=Request.Form.Files[0];var ext=System.IO.Path.GetExtension(f.FileName).ToLower();if(ext==".png"||ext==".jpg"||ext==".jpeg"){var name=Guid.NewGuid().ToString()+ext;using(var fs=System.IO.File.Create(System.IO.Path.Combine("uploads",name))){f.CopyTo(fs);}return Ok();}return BadRequest();}}